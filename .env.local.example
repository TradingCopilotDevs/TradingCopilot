APP_ENV=dev
APP_SECRET_KEY=local-dev-secret-change-before-real-use-32-bytes
JWT_SECRET_KEY=local-dev-jwt-secret-change-before-real-use
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000/api
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=sqlite+aiosqlite:///./data/local-dev.db
REDIS_URL=redis://localhost:6379/0
AUTO_CREATE_TABLES=true

DEFAULT_MARKET_PROVIDER=adata
MARKET_REALTIME_PROVIDER=adata
MARKET_REALTIME_COMPAT_PROVIDER=tencent
MARKET_REALTIME_CACHE_TTL_SECONDS=5
MEETING_DISPATCH_MODE=local
MESSAGE_TASK_QUEUE_MODE=local
MESSAGE_SUBSCRIPTION_LISTENERS_IN_SERVE=true
MEETING_MAX_ROUNDS=6
MEETING_DAILY_TOKEN_BUDGET=-1
MEETING_STALE_AFTER_SECONDS=1800
MEETING_AUTO_REQUEUE_LIMIT=2
MEETING_RUN_TIMEOUT_SECONDS=7200
AI_CHAT_TIMEOUT_SECONDS=90
AI_CHAT_MAX_ATTEMPTS=5
AI_CHAT_BACKOFF_BASE_SECONDS=1
AI_CHAT_BACKOFF_MAX_SECONDS=20
AI_JSON_MAX_ATTEMPTS=3
TOOL_RESULT_LIMIT=200
SQL_STATEMENT_TIMEOUT_MS=5000
LOG_DIR=./logs
LOG_LEVEL=info
LOG_ROTATION_MODE=size
LOG_ROTATION_SIZE_MB=5
LOG_ROTATION_TOTAL_SIZE_MB=100
LOG_ROTATION_MAX_AGE_DAYS=7
BACKUP_ARCHIVE_PROVIDER=local
BACKUP_ARCHIVE_S3_BUCKET=
BACKUP_ARCHIVE_S3_REGION=
BACKUP_ARCHIVE_S3_ENDPOINT=
BACKUP_ARCHIVE_S3_ACCESS_KEY_ID=
BACKUP_ARCHIVE_S3_SECRET_ACCESS_KEY=
BACKUP_ARCHIVE_S3_PREFIX=
BACKUP_ARCHIVE_OSS_BUCKET=
BACKUP_ARCHIVE_OSS_REGION=
BACKUP_ARCHIVE_OSS_ENDPOINT=
BACKUP_ARCHIVE_OSS_ACCESS_KEY_ID=
BACKUP_ARCHIVE_OSS_ACCESS_KEY_SECRET=
BACKUP_ARCHIVE_OSS_PREFIX=
BACKUP_RETENTION_COPIES=7
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_DRILL_INTERVAL_HOURS=168
OTEL_SERVICE_NAME=
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=
VITE_API_BASE_URL=/api
